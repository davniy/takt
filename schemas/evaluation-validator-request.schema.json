{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-validator-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "case_id", "repeat", "workspace", "baseline_workspace", "expected_path", "run"],
  "properties": {
    "protocol_version": {"const": "takt-evaluation-validator/v1alpha1"},
    "type": {"const": "validation_request"},
    "case_id": {"type": "string"},
    "repeat": {"type": "integer", "minimum": 0},
    "workspace": {"type": "string"},
    "baseline_workspace": {"type": "string"},
    "expected_path": {"type": "string"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "artifacts_dir"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string"},
        "artifacts_dir": {"type": "string"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "mime", "path", "sha256", "size", "producer_run_id", "producer_node_id", "attempt", "created_at"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "mime": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "size": {"type": "integer", "minimum": 0},
              "producer_run_id": {"type": "string"},
              "producer_node_id": {"type": "string"},
              "attempt": {"type": "integer", "minimum": 1},
              "created_at": {"type": "string", "format": "date-time"},
              "call_id": {"type": "string"}
            }
          }
        }
      }
    },
    "external_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"scm_dir": {"type": "string"}}
    }
  }
}
